ZEPP_APP_TOKEN=
ZEPP_USER_ID=
ZEPP_HOST=api-mifit-us3.zepp.com
ZEPP_REGION=eu
# Optional. Defaults to <repo-root>/data/raw
# DATA_RAW_DIR=

# Optional. Defaults to <repo-root>/data/zepp.duckdb
# DUCKDB_PATH=

# Optional. Defaults to <repo-root>/data/profile.json
# PROFILE_PATH=

# Optional. Path to Zepp credentials file (defaults to <repo-root>/data/zepp.env)
# ZEPP_ENV_PATH=

# Optional. Path to sync job state (defaults to <repo-root>/data/_meta/sync_job.json)
# SYNC_JOB_PATH=

# Optional. Defaults to http://localhost:5173; production: https://training.xbonell.com
# API_CORS_ORIGIN=
